 issn = {2048-8505, 2048-8513},
 journal = {Clin. Kidney J.},
 keywords = {_first_author,_GFR,_Karolinska Institutet,_my_publications,_original_article,_predictive modeling},
 langid = {english},
 month = {June},
 pages = {sfag187},
 title = {Similar Predictive Performance and Clinical Utility of the Kidney Failure Risk Equation Using EKFC or CKD-EPI Estimated Glomerular Filtration Rate},
 urldate = {2026-06-09},
